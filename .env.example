# Admin login. Required in production; defaults to "admin" in local dev when unset.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SECRET=replace-with-a-long-random-string

# Database. Leave unset locally to use ./data/swing.db.
# On Vercel, point these at a Turso (hosted libSQL/SQLite) database for persistence.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
